+    return res.status(400).json({ message: "CSV contains invalid rows.", errors });
+  }
+
+  try {
+    const categoryValues = [...new Set(rows.map((row) => row.category))];
+    const categoryIds = categoryValues.filter((value) => mongoose.isValidObjectId(value));
+    const categories = await Category.find({
+      $or: [
+        { name: { $in: categoryValues } },
+        ...(categoryIds.length ? [{ _id: { $in: categoryIds } }] : []),
+      ],
+    });
+    const categoryMap = new Map();
+    categories.forEach((category) => {
+      categoryMap.set(category.name.toLowerCase(), category._id);
+      categoryMap.set(category._id.toString(), category._id);
+    });
+
+    const duplicateErrors = [];
+    const namesInFile = new Set();
+    rows.forEach((row) => {
+      const key = row.name.toLowerCase();
+      if (namesInFile.has(key)) duplicateErrors.push({ row: row.rowNumber, message: `Duplicate product name: ${row.name}.` });
+      namesInFile.add(key);
+      if (!categoryMap.has(row.category.toLowerCase())) {
+        duplicateErrors.push({ row: row.rowNumber, message: `Category not found: ${row.category}.` });
+      }
+    });
+
+    const existingProducts = await Product.find({ name: { $in: rows.map((row) => row.name) } }).select("name");
+    const existingNames = new Set(existingProducts.map((product) => product.name.toLowerCase()));
+    rows.forEach((row) => {
+      if (existingNames.has(row.name.toLowerCase())) {
+        duplicateErrors.push({ row: row.rowNumber, message: `Product already exists: ${row.name}.` });
+      }
+    });
+
+    if (duplicateErrors.length) {
+      return res.status(400).json({ message: "CSV contains invalid rows.", errors: duplicateErrors });
+    }
+
+    const products = rows.map((row) => ({
+      name: row.name,
+      Desciption: row.description,
+      Category: categoryMap.get(row.category.toLowerCase()),
+      Price: row.price,
+      quantity: row.quantity,
+    }));
+    const createdProducts = await Product.insertMany(products, { ordered: true });
+
+    await logActivity({
+      action: "Bulk Add Products",
+      description: `${createdProducts.length} products were imported`,
+      entity: "product",
+      entityId: createdProducts[0]._id,
+      userId: req.user._id,
+      ipAddress: req.ip,
+    });
+
+    return res.status(201).json({ message: "Products imported successfully.", importedCount: createdProducts.length });
+  } catch (error) {
+    return res.status(500).json({ message: "Error importing products.", error: error.message });
+  }
+};
+
+module.exports.exportProducts = async (req, res) => {
+  try {
+    const filter = {};
+    if (req.query.query) {
+      filter.$or = [
+        { name: { $regex: req.query.query, $options: "i" } },
+        { Desciption: { $regex: req.query.query, $options: "i" } },
+      ];
+    }
+    if (req.query.category) {
+      const category = mongoose.isValidObjectId(req.query.category)
+        ? req.query.category
+        : await Category.findOne({ name: { $regex: `^${req.query.category}$`, $options: "i" } }).select("_id");
+      filter.Category = category?._id || category;
+    }
+
+    const products = await Product.find(filter).populate("Category").sort({ createdAt: -1 });
+    const lines = ["name,description,category,price,quantity"];
+    products.forEach((product) => {
+      lines.push([
+        product.name,
+        product.Desciption,
+        product.Category?.name || "",
+        product.Price,
+        product.quantity,
+      ].map(csvEscape).join(","));
+    });
+
+    res.set({ "Content-Type": "text/csv; charset=utf-8", "Content-Disposition": "attachment; filename=products.csv" });
+    return res.status(200).send(lines.join("\n"));
+  } catch (error) {
+    return res.status(500).json({ message: "Error exporting products.", error: error.message });
+  }
+};
