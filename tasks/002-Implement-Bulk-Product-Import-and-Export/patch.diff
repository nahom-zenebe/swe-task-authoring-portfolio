+  export const ImportProducts = createAsyncThunk('product/importProducts', async (file, { rejectWithValue }) => {
+    try {
+      const formData = new FormData();
+      formData.append('file', file);
+      const response = await axiosInstance.post('product/import', formData, { withCredentials: true });
+      return response.data;
+    } catch (error) {
+      return rejectWithValue(error.response?.data || { message: 'Product import failed.' });
+    }
+  });
+
+  export const ExportProducts = createAsyncThunk('product/exportProducts', async ({ query, category }, { rejectWithValue }) => {
+    try {
+      const response = await axiosInstance.get('product/export', {
+        params: { query: query || undefined, category: category || undefined },
+        responseType: 'blob',
+        withCredentials: true,
+      });
+      return response.data;
+    } catch (error) {
+      return rejectWithValue(error.response?.data?.message || 'Product export failed.');
+    }
+  });
